# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (SQLite local — caminho relativo à pasta prisma/)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="troque-por-uma-chave-secreta-longa"
JWT_EXPIRES_IN=3600

# LGPD — chave para criptografia de dados pessoais em repouso (CPF)
DATA_ENCRYPTION_KEY="troque-por-outra-chave-secreta-longa"
LGPD_DATA_RETENTION_DAYS=365

# Pagamento mock — taxa de aprovação quando nenhum "cenario" é informado (0 a 1)
PAGAMENTO_TAXA_APROVACAO=0.8

# Logs
LOG_LEVEL="info"
